# Monorepo .gitignore

# Node dependencies
/app-front/node_modules
/sanity-studio/node_modules
/.pnp
.pnp.*

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/app-front/coverage
/sanity-studio/coverage

# Next.js
/app-front/.next/
/app-front/out/

# Sanity Studio
/sanity-studio/.next/
/sanity-studio/out/
/sanity-studio/dist/

# Production
/app-front/build
/sanity-studio/build

# Misc
.DS_Store
*.pem
.env.local
.env.*.local

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
